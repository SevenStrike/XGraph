<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:VisualElement name="item" style="flex-direction: row; align-items: flex-start; height: 55px;">
        <engine:Label text="vcdf" name="ver" style="-unity-text-align: middle-center; width: 50px; margin-left: 0; background-color: rgb(26, 26, 26); color: rgb(204, 204, 204); -unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&amp;guid=7e75af13bdd075345ab6bcc4962b42c2&amp;type=3#x_Regular&quot;); padding-top: 2px; padding-bottom: 2px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; font-size: 11px; -unity-font-style: bold; letter-spacing: 5px; margin-right: 24px; margin-top: 10px; overflow: hidden; text-overflow: ellipsis;" />
        <engine:VisualElement name="title" style="height: 100%; justify-content: space-between; flex-grow: 1; padding-bottom: 5px;">
            <engine:Label text="CaptureTitle" name="name" style="-unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&amp;guid=72f2755737ddb2545a774f68d54027aa&amp;type=3#x_Heavy&quot;); margin-top: 8px; font-size: 12px; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
            <engine:Label text="time / date" name="datetime" style="font-size: 11px; -unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&amp;guid=7e75af13bdd075345ab6bcc4962b42c2&amp;type=3#x_Regular&quot;); color: rgba(255, 255, 255, 0.5); margin-bottom: 5px; -unity-text-align: middle-left;" />
        </engine:VisualElement>
        <engine:VisualElement name="title" style="height: 100%; justify-content: flex-end; flex-grow: 1; padding-bottom: 5px; align-items: center; flex-direction: row;">
            <engine:Button name="btn_discard" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&amp;guid=7e75af13bdd075345ab6bcc4962b42c2&amp;type=3#x_Regular&quot;); height: 20px; right: 0; flex-grow: 0; padding-left: 10px; padding-right: 10px; background-color: rgb(164, 70, 70); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; color: rgb(255, 255, 255); margin-right: 15px;" />
            <engine:Button text="恢复" name="btn_restore" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&amp;guid=7e75af13bdd075345ab6bcc4962b42c2&amp;type=3#x_Regular&quot;); height: 20px; right: 0; flex-grow: 0; padding-left: 10px; padding-right: 10px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>

<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/SevenStrikeModules/XGraph/GUI/Uss/uss_OptionsPanel.uss?fileID=7433441132597879392&amp;guid=eac0a75721ece66449117b5853565d63&amp;type=3#uss_OptionsPanel" />
    <engine:VisualElement name="OptionsPanel" picking-mode="Ignore" enabled="true" style="position: absolute; width: 100%; height: 100%; flex-direction: column; justify-content: flex-end; align-content: flex-end;">
        <engine:VisualElement name="ExpandContainer" picking-mode="Ignore" style="position: absolute; height: 50px; width: 50px; flex-direction: column; flex-grow: 0; flex-shrink: 0; align-self: center; justify-content: center; align-items: center;">
            <engine:Button name="btn_expand" class="btn_expand" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        </engine:VisualElement>
        <engine:VisualElement name="OptionsContainer" picking-mode="Ignore" enabled="true" class="OptionsContainer" style="position: relative;">
            <engine:VisualElement name="reg_color" class="OptionsContainer_InsideRegion_Color" style="flex-grow: 0; justify-content: flex-start; overflow: hidden;">
                <engine:VisualElement name="left">
                    <engine:Label text="配色" name="Title" class="OptionsTitle" />
                    <engine:VisualElement name="color_bg" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="背景色" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" />
                    </engine:VisualElement>
                    <engine:VisualElement name="color_grid" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="网格" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="color_thickline" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="分界线" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="color_bgimage" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="背景图像着色" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="color_themecolor" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="主题色" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="right" style="padding-top: 0; margin-top: 33px;">
                    <engine:VisualElement name="color_bg_blackboard" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="变量面板背景" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" />
                    </engine:VisualElement>
                    <engine:VisualElement name="color_bg_inspector" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                        <engine:Label text="属性面板背景" name="title" class="ParamFieldTitle" />
                        <editor:ColorField name="colorfield" value="#000000FF" class="ParamField" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="toggle_invert_bg_gradient" class="ColorFieldContainer ParamFieldContainer" style="margin-bottom: 14px;">
                        <engine:Label text="背景渐变反转" name="title" class="ParamFieldTitle" />
                        <engine:Toggle name="toggle" class="ParamField" />
                    </engine:VisualElement>
                    <engine:VisualElement name="Buttons" style="flex-direction: row; align-items: center; align-self: auto; margin-top: 12px;">
                        <engine:Button text="主题样式方案" name="button_theme_set" class="ButtonText" style="width: auto; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; height: 30px; margin-top: 0; flex-grow: 1;" />
                        <engine:Button text="重置" name="button_theme_reset" class="ButtonText" style="width: auto; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; height: 30px; margin-top: 0; flex-grow: 1;" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="sepline" class="sepline" style="width: 1px; background-image: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/sepline.png?fileID=2800000&amp;guid=df626e800f8f8744baf117e45cfdaf7a&amp;type=3#sepline&quot;);" />
            <engine:VisualElement name="reg_params" class="OptionsContainer_InsideRegion_Param" style="flex-grow: 0; justify-content: flex-start; flex-direction: column; overflow: hidden;">
                <engine:Label text="参数" name="Title" class="OptionsTitle" />
                <engine:VisualElement name="param_gridspace" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                    <engine:Label text="网格间距" name="title" class="ParamFieldTitle" />
                    <engine:FloatField value="0" name="floatfield_gridspace" class="ParamField" />
                </engine:VisualElement>
                <engine:VisualElement name="param_thicklinecount" class="ColorFieldContainer ParamFieldContainer" style="width: auto;">
                    <engine:Label text="分界线数量" name="title" class="ParamFieldTitle" />
                    <engine:IntegerField value="0" name="integerfield_thicklinecount" class="ParamField" />
                </engine:VisualElement>
                <engine:VisualElement name="param_bgimage" class="ColorFieldContainer ParamFieldContainer">
                    <engine:Label text="背景图像" name="title" class="ParamFieldTitle" />
                    <editor:ObjectField allow-scene-objects="false" type="UnityEngine.Texture2D, UnityEngine.CoreModule" name="objectfield_customimage" class="ParamField" />
                </engine:VisualElement>
                <engine:Button text="恢复默认" name="button_reset" class="ButtonText" style="width: auto; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; height: 30px; margin-top: 12px;" />
            </engine:VisualElement>
            <engine:VisualElement name="sepline" class="sepline" />
            <engine:VisualElement name="reg_rectselector" class="OptionsContainer_InsideRegion_Param" style="flex-grow: 0; justify-content: flex-start; flex-direction: column; overflow: hidden;">
                <engine:Label text="选框" name="Title" class="OptionsTitle" />
                <engine:VisualElement name="param_selectorlinecolor" class="ColorFieldContainer ParamFieldContainer">
                    <engine:Label text="线框色" name="title" class="ParamFieldTitle" />
                    <editor:ColorField name="colorfield_selectorlinecolor" value="#FFFFFFFF" class="ParamField" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                </engine:VisualElement>
                <engine:VisualElement name="param_selectorline_seg" class="ColorFieldContainer ParamFieldContainer">
                    <engine:Label text="线分段" name="title" class="ParamFieldTitle" />
                    <engine:IntegerField value="0" name="integerfield_selectorline_seg" class="ParamField" />
                </engine:VisualElement>
                <engine:VisualElement name="param_selectorline_displaycoordinate" class="ColorFieldContainer ParamFieldContainer" style="margin-bottom: 14px;">
                    <engine:Label text="坐标显示" name="title" class="ParamFieldTitle" />
                    <engine:Toggle name="toggle_selectorline_displaycoordinate" class="ParamField" />
                </engine:VisualElement>
                <engine:Button text="恢复默认" name="button_reset" class="ButtonText" style="width: auto; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; margin-top: 12px; height: 30px;" />
            </engine:VisualElement>
            <engine:VisualElement name="sepline" class="sepline" />
            <engine:VisualElement name="reg_blackboards" class="OptionsContainer_InsideRegion_BlackBoards" style="flex-grow: 0; justify-content: flex-start; flex-direction: column; overflow: hidden;">
                <engine:Label text="标记" name="Title" class="OptionsTitle" />
                <engine:VisualElement name="paramTypes" picking-mode="Ignore" style="flex-grow: 0; flex-direction: row;">
                    <engine:VisualElement name="reg_left" picking-mode="Ignore">
                        <engine:VisualElement name="param_type_String" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" />
                            <engine:Label text="String" name="lab_String" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                        <engine:VisualElement name="param_type_Bool" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" />
                            <engine:Label text="Bool" name="lab_Bool" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                        <engine:VisualElement name="param_type_Float" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" />
                            <engine:Label text="Float" name="lab_Float" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                        <engine:VisualElement name="param_type_Int" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" />
                            <engine:Label text="Integer" name="lab_Int" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement name="reg_right" picking-mode="Ignore">
                        <engine:VisualElement name="param_type_Color" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
                            <engine:Label text="Color" name="lab_Color" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                        <engine:VisualElement name="param_type_Vector2" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" />
                            <engine:Label text="Vector 2" name="lab_Vector2" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                        <engine:VisualElement name="param_type_Vector3" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
                            <engine:Label text="Vector 3" name="lab_Vector3" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                        <engine:VisualElement name="param_type_Vector4" class="paramtype_container">
                            <engine:VisualElement name="dot" class="BlackBoardVarMark" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
                            <engine:Label text="Vector 4" name="lab_Vector4" class="ParamFieldBoldTitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="sepline" class="sepline" />
            <engine:VisualElement name="reg_other" class="OptionsContainer_InsideRegion_Other" style="overflow: hidden;">
                <engine:VisualElement name="Abouts" picking-mode="Ignore" enabled="true" style="flex-direction: column-reverse; align-items: flex-end; flex-grow: 1; overflow: hidden; margin-bottom: 10px;">
                    <engine:Label text="Powered By SevenStrike Media" name="CompanyName" style="-unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&amp;guid=7e75af13bdd075345ab6bcc4962b42c2&amp;type=3#x_Regular&quot;); font-size: 11px; margin-bottom: 12px; text-overflow: ellipsis; flex-shrink: 1; overflow: hidden; letter-spacing: 15px; color: rgba(210, 210, 210, 0.31); margin-right: 0; padding-right: 0; padding-left: 0; margin-top: 5px;" />
                    <engine:VisualElement name="ProductName" style="flex-direction: row-reverse; align-items: flex-end; justify-content: space-between; padding-bottom: 0; margin-bottom: 10px;">
                        <engine:Label text="1.0" name="xGraphVersion" style="-unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&amp;guid=7e75af13bdd075345ab6bcc4962b42c2&amp;type=3#x_Regular&quot;); font-size: 12px; margin-bottom: 0; text-overflow: ellipsis; flex-shrink: 1; overflow: hidden; letter-spacing: 10px; padding-right: 0; padding-left: 0; color: rgba(255, 255, 255, 0.8); margin-left: 13px;" />
                        <engine:Label text="X-GRAPH" name="xGraphName" style="-unity-font-definition: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&amp;guid=72f2755737ddb2545a774f68d54027aa&amp;type=3#x_Heavy&quot;); font-size: 24px; margin-bottom: 0; text-overflow: ellipsis; flex-shrink: 1; overflow: hidden; letter-spacing: 10px; padding-right: 0; padding-left: 0; color: rgba(255, 255, 255, 0.8);" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Button name="btn_close" class="btn_close" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/close.png?fileID=2800000&amp;guid=ebe30fe61a64f7b4a94633a76720d557&amp;type=3#close&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>

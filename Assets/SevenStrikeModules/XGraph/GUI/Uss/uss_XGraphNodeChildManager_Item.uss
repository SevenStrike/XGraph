.item_identityname {
    -unity-text-align: middle-left;
    padding-left: 5px;
    text-overflow: ellipsis;
    overflow: hidden;
    top: auto;
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
    -unity-font-style: bold;
}

.item_actionType {
    -unity-text-align: middle-right;
    flex-grow: 1;
    padding-left: 5px;
    flex-shrink: 1;
    text-overflow: ellipsis;
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
    padding-right: 10px;
    height: auto;
    top: auto;
    color: rgba(210, 210, 210, 0.5);
    font-size: 11px;
}

.container
{
     flex-direction: column;
     width: 100%;
     color: rgb(255, 255, 255);
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
     font-size: 12px;
     margin-top: 0;
     margin-right: 0;
     margin-bottom: 0;
     margin-left: 0;
     padding-top: 0;
     padding-right: 0;
     padding-bottom: 0;
     padding-left: 0;
     overflow: visible;
}

.titlegroup
{
     flex-direction: row;
     align-items: center;
     width: 100%;
     height: auto;
     margin-top: 0;
     margin-right: 0;
     margin-bottom: 5px;
     margin-left: 0;
     padding-top: 10px;
     padding-right: 5px;
     padding-bottom: 15px;
     padding-left: 0;
     border-bottom-width: 1px;
     border-bottom-color: rgba(255, 255, 255, 0.2);
}

.titlename
{
     color: rgba(255, 255, 255, 0.85);
     height: 10px;
     width: 30px;
     font-size: 15px;
     -unity-text-align: middle-left;
     -unity-font-style: normal;
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&guid=72f2755737ddb2545a774f68d54027aa&type=3#x_Heavy");
     letter-spacing: 5px;
     padding-left: 0;
     padding-top: 0;
     padding-bottom: 0;
     margin-top: 0;
     margin-bottom: 0;
     margin-left: 10px;
}

.titlemark
{
     color: rgba(255, 255, 255, 0.85);
     height: 18px;
     width: 4px;
     left: 1px;
     letter-spacing: 5px;
     padding-left: 0;
     padding-top: 0;
     margin-top: 0;
     margin-left: 0;
     margin-right: 10px;
}

.titleicon
{
     color: rgba(255, 255, 255, 0.85);
     height: 18px;
     width: 18px;
     letter-spacing: 5px;
     padding-left: 0;
     padding-top: 0;
     margin-top: 0;
     margin-left: 0;
}

.type
{
     position: absolute;
     right: 0;
     top: 12px;
     color: rgb(0, 0, 0);
     height: 15px;
     width: 65px;
     font-size: 11px;
     -unity-text-align: middle-center;
     -unity-font-style: normal;
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&guid=72f2755737ddb2545a774f68d54027aa&type=3#x_Heavy");
     letter-spacing: 5px;
     padding-left: 10px;
     padding-right: 10px;
     padding-top: 0;
     padding-bottom: 0;
     /*margin-top: 0;*/
     margin-bottom: 0;
     margin-left: 0;
     margin-right: 6px;
     align-self: flex-start;
     background-color: rgba(255, 255, 255, 0.85);
     border-top-left-radius: 6px;
     border-top-right-radius: 6px;
     border-bottom-right-radius: 6px;
     border-bottom-left-radius: 6px;
}

.description
{
     position: relative;
     color: rgba(255, 255, 255, 0.55);
     height: 25px;
     width: auto;
     font-size: 12px;
     -unity-text-align: middle-left;
     -unity-font-style: bold;
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
     letter-spacing: 5px;
     padding-left: 0;
     padding-right: 10px;
     padding-top: 5px;
     padding-bottom: 0;
     margin-top: 0;
     margin-bottom: 5px;
     margin-left: 0;
     margin-right: 0;
     overflow: hidden;
     text-overflow: ellipsis;
}

.labeltext
{
     position: relative;
     color: rgba(255, 255, 255, 0.8);
     height: 25px;
     width: auto;
     font-size: 12px;
     -unity-text-align: middle-left;
     -unity-font-style: bold;
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
     letter-spacing: 5px;
     padding-left: 0;
     padding-right: 10px;
     padding-top: 5px;
     padding-bottom: 0;
     margin-top: 2px;
     margin-bottom: 2px;
     margin-left: 0;
     margin-right: 0;
     overflow: hidden;
     text-overflow: ellipsis;
}


.ToolbarButon {
    width: 40px;
    -unity-text-align: middle-center;
    letter-spacing: 20px;
}

.MarkText {
    position: absolute;
    top: auto;
    left: 30px;
    font-size: 30px;
    color: rgba(139, 139, 139, 0.17);
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&guid=72f2755737ddb2545a774f68d54027aa&type=3#x_Heavy");
    bottom: 15px;
}

.BlackBoard_Icon {
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 10px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/Icon.png?fileID=2800000&guid=8284d08a7854be04da1ce19338e8f6c7&type=3#Icon");
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.BlackBoard_AssetName {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
    font-size: 17px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 15px;
    padding-bottom: 0;
    padding-left: 0;
    width: auto;
    left: auto;
    max-width: none;
    flex-wrap: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.unity-button.btn_addBlackBoardParam {
    position: absolute;
    left: auto;
    right: auto;
    top: auto;
    background-image: url("project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/Add.png?fileID=2800000&guid=046083fdec292bc4fa9d875b5c8ff1ab&type=3#Add");
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.1);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    flex-direction: row-reverse;
    flex-shrink: 0;
    flex-grow: 0;
    bottom: auto;
}

.unity-button:hover:enabled.btn_addBlackBoardParam {
    position: absolute;
    left: auto;
    right: 15px;
    top: 5px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.7);
    background-image: url("project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/Add.png?fileID=2800000&guid=046083fdec292bc4fa9d875b5c8ff1ab&type=3#Add");
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.1);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.unity-button:active:enabled.btn_addBlackBoardParam {
    position: absolute;
    left: auto;
    right: 15px;
    top: 5px;
    -unity-background-image-tint-color: rgb(59, 254, 155);
    background-image: url("project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/Add.png?fileID=2800000&guid=046083fdec292bc4fa9d875b5c8ff1ab&type=3#Add");
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.25);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.BlackBoard_Divide {
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
    margin-top: 10px;
    margin-bottom: 10px;
    padding-left: 0;
    margin-left: 10px;
    margin-right: 10px;
}

.BlackBoard_Sub {
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 10px;
    padding-bottom: 0;
    padding-left: 12px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
    text-overflow: ellipsis;
}

.BlackBoard_Container_Title {
    color: rgba(255, 255, 255, 0.7);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 13px;
    -unity-font-style: normal;
    background-color: rgb(29, 29, 29);
    padding-top: 6px;
    padding-right: 15px;
    padding-bottom: 6px;
    padding-left: 15px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&guid=72f2755737ddb2545a774f68d54027aa&type=3#x_Heavy");
}

.InspectorView_Container_Title {
    color: rgba(255, 255, 255, 0.7);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&guid=72f2755737ddb2545a774f68d54027aa&type=3#x_Heavy");
    font-size: 13px;
    -unity-font-style: normal;
    background-color: rgb(29, 29, 29);
    padding-top: 6px;
    padding-right: 15px;
    padding-bottom: 6px;
    padding-left: 15px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.VariableListWarningText {
    display: none;
    position: absolute;
    align-self: center;
    top: 45%;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
    color: rgb(103, 103, 103);
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 150px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 13px;
}

.captureshot {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-cubic;
    transition-delay: 0s;
}

.capture_btn_icon {
    width: 15px;
    height: 15px;
}

.capture_btn_text {
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
}

.capture_btn {
    width: 100px;
    height: 25px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
    padding-top: 5px;
    padding-right: 10px;
    padding-bottom: 5px;
    padding-left: 10px;
    background-color: rgba(0, 0, 0, 0.36);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    transition-property: opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.capture_mask {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.capture_dialog {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-width: 0.5px;
    border-right-width: 0.5px;
    border-bottom-width: 0.5px;
    border-left-width: 0.5px;
    border-left-color: rgba(121, 121, 121, 0.47);
    border-right-color: rgba(121, 121, 121, 0.47);
    border-top-color: rgba(121, 121, 121, 0.47);
    border-bottom-color: rgba(121, 121, 121, 0.47);
    background-size: 300px 150px;
    width: 350px;
    height: auto;
    background-color: rgb(56, 56, 56);
    display: flex;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-circ;
    transition-delay: 0.12s, 0s;
}

.capture_field {
    margin-top: 15px;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
    height: 20px;
}

.unity-text-field__label {
    min-width: 80px;
    font-size: 11px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
}

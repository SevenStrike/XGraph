.Content_TextField
{
     color: rgb(255, 255, 255);
     display: none;
     height: auto;
     width: 100%;
     -unity-text-align: upper-left;
     margin: 0;
     font-size: 14px;
}

.unity-text-element.Content_Label
{
     color: rgb(255, 255, 255);
     height: 100%;
     width: 100%;
     -unity-text-align: upper-left;
     /*-unity-font-style: normal;*/
     /*-unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");*/
     letter-spacing: 3px;
     padding-top: 6px;
     padding-bottom: 10px;
     padding-left: 10px;
     padding-right: 8px;
     margin-top: 0;
     top: 0;
     text-overflow: ellipsis;
     overflow: hidden;
     white-space: normal;
     font-size: 13px;
     flex-basis: auto;
}

.resizer-icon
{
     right: 10px;
     bottom: 10px;
     background-image: url("project://database/Assets/SevenStrikeModules/XGraph/GUI/Icons/resize.png?fileID=2800000&guid=7ee37ab7fc61a8a43bfae9fed2cb81cf&type=3#resize");
     background-size: 100% 100%;
     -unity-background-image-tint-color: rgba(74, 74, 74, 0.82);
     background-color: rgba(0, 0, 0, 0);
     width: 50%;
     height: 50%;
     position: absolute;
}

#unity-text-input
{
     background-color: rgba(0, 0, 0, 0);
     border-bottom-color: rgba(0, 0, 0, 0);
     border-top-color: rgba(0, 0, 0, 0);
     border-left-color: rgba(0, 0, 0, 0);
     border-right-color: rgba(0, 0, 0, 0);
     width: 100%;
     height: auto;
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Regular.ttf?fileID=12800000&guid=7e75af13bdd075345ab6bcc4962b42c2&type=3#x_Regular");
     color: rgb(128, 128, 128);
     letter-spacing: 3px;
     padding-top: 0;
     padding-right: 10px;
     padding-bottom: 5px;
     padding-left: 10px;
     margin-top: 0;
     -unity-font-style: normal;
     top: 0;
     flex-grow: 1;
     -unity-text-align: upper-left;
     text-overflow: clip;
     overflow: hidden;
     white-space: normal;
     font-size: 12px;
     flex-basis: auto;
}

.unity-text-element
{
     font-size: 13px;
     height: auto;
}

#title
{
     display: none;
}

#node-border
{
     margin: 0;
     border-left-color: rgba(0, 0, 0,0);
     border-right-color: rgba(0, 0, 0,0);
     border-top-color: rgba(0, 0, 0,0);
     border-bottom-color: rgba(0, 0, 0,0);
}

#FontSizerContainer
{
     position: absolute;
     width: auto;
     height: auto;
     flex-direction: row-reverse;
     align-self: flex-end;
     top: -30px;
}

.button
{
     width: 20px;
     height: 20px;
     background-color: transparent;
     border-color: transparent;
     overflow: visible;
}

.button:hover
{
     -unity-background-image-tint-color: rgb(128, 128, 128);
}

.button:active
{
     -unity-background-image-tint-color: white;
}

.sizefield
{
     background-color: rgb(35, 35, 35);
     align-self: center;
     border-left-color: rgba(85, 85, 85, 1);
     border-right-color: rgba(85, 85, 85, 1);
     border-top-color: rgba(85, 85, 85, 1);
     border-bottom-color: rgba(85, 85, 85, 1);
     border-bottom-left-radius: 8px;
     border-top-left-radius: 8px;
     border-top-right-radius: 8px;
     border-bottom-right-radius: 8px;
     border-bottom-width: 1px;
     border-top-width: 1px;
     border-left-width: 1px;
     border-right-width: 1px;
     height: 20px;
     width: 40px;
}

#unity-text-input.sizefieldInput
{
     padding-bottom: 0px;
     padding-left: 0px;
     padding-right: 0px;
}

.sizefieldText
{
     color: rgb(234, 234, 234);
     align-self: center;
     font-size: 11px;
     -unity-text-align: middle-center;
     -unity-font-style: normal;
     -unity-font-definition: url("project://database/Assets/SevenStrikeModules/XGraph/Fonts/x_Heavy.ttf?fileID=12800000&guid=72f2755737ddb2545a774f68d54027aa&type=3#x_Heavy");
}

.button_mark
{
     width: 4px;
     height: 4px;
     background-color: white;
     left: -8px;
     top: -4px;
     border-bottom-left-radius: 4px;
     border-top-left-radius: 4px;
     border-top-right-radius: 4px;
     border-bottom-right-radius: 4px;
     transition-property: opacity;
     transition-duration: 0.15s;
     transition-timing-function: ease-out-cubic;
}

.sizefieldTextmultilinecontainer
{
     padding-top: 6px;
     padding-bottom: 6px;
}
